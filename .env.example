# ──────────────────────────────────────────────────────────────────
#  Variables de entorno
# ──────────────────────────────────────────────────────────────────
#  Copia este archivo a `.env.local` y ajusta la cadena de conexión a
#  tu PostgreSQL local. `.env.local` NO se sube a git (.gitignore).
#
#  Formato:
#    postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS
#
#  La app usa un usuario dedicado (no el superusuario "postgres").
#  Ver README → "Base de datos" para crearlo.
# ──────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://supersacos_app:TU_PASSWORD@localhost:5432/supersacos
