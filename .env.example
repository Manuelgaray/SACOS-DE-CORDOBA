# ──────────────────────────────────────────────────────────────────
#  Variables de entorno
# ──────────────────────────────────────────────────────────────────
#  Copia este archivo a `.env.local` y rellena los valores.
#  `.env.local` NO se sube a git (está en .gitignore).
#
#  Estas MISMAS cuatro variables hay que darlas de alta en Vercel
#  (Project Settings → Environment Variables) para el despliegue.
# ──────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────
#  Supabase: usa la cadena del TRANSACTION POOLER (puerto 6543), no la
#  directa del 5432 — es la que aguanta serverless.
#
#  ⚠ Si la contraseña lleva caracteres especiales (@ / : ? #) hay que
#    codificarlos: una "@" se escribe %40. Si no, la URL no se puede leer.
#
#  Para desarrollo con PostgreSQL local:
#    postgresql://supersacos_app:TU_PASSWORD@localhost:5432/supersacos
DATABASE_URL=postgresql://postgres.PROYECTO:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── Supabase: cuentas y almacenamiento ───────────────────────────
#  Las dos primeras son PÚBLICAS (viajan al navegador).
NEXT_PUBLIC_SUPABASE_URL=https://PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

#  ⚠ LLAVE MAESTRA: se salta todas las reglas de la base. Solo servidor.
#    Nunca la pongas en una variable NEXT_PUBLIC_ ni la compartas.
SUPABASE_SECRET_KEY=sb_secret_...
